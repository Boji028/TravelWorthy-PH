{% extends "base.html" %}
{% block title %}Travel Worthy PH — Discover the World{% endblock %}

{% block extra_styles %}
<style>
  /* ── HERO ── */
  .hero {
    background: url('/static/images/PrimaryBG.jpg') center center / cover no-repeat;
    min-height: 500px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 50, 60, .52);
  }

  .hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 2rem 2.5rem;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: rgba(255, 255, 255, .12);
    border: 1px solid rgba(255, 255, 255, .25);
    border-radius: 999px;
    padding: .3rem .9rem;
    font-size: .78rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    color: #fff;
  }

  .hero h1 {
    font-family: 'Pogonia', serif;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 1rem;
    color: #fff;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--teal-d);
  }

  .hero-sub {
    font-size: .95rem;
    opacity: .88;
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 480px;
    color: #fff;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: var(--amber);
    color: white;
    border: none;
    border-radius: 999px;
    padding: .72rem 1.6rem;
    font-size: .92rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all .22s;
  }

  .btn-hero-primary:hover {
    background: #d4712a;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(239, 130, 51, .35);
  }

  .btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: transparent;
    color: white;
    border: 1.5px solid rgba(255, 255, 255, .45);
    border-radius: 999px;
    padding: .72rem 1.6rem;
    font-size: .92rem;
    cursor: pointer;
    text-decoration: none;
    transition: all .22s;
  }

  .btn-hero-ghost:hover {
    background: rgba(255, 255, 255, .1);
    border-color: rgba(255, 255, 255, .8);
  }

  /* ── SEARCH BAR ── */
  .search-section {
    position: absolute;
    bottom: -22px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 4rem);
    max-width: 900px;
    z-index: 10;
    pointer-events: auto;
  }

  .search-heading {
    font-family: 'Pogonia', serif;
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    font-weight: 600;
    color: #fff;
    text-align: center;
    margin-bottom: 1rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .35);
    letter-spacing: -.01em;
  }

  .search-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgba(23, 89, 104, .18);
    display: flex;
    align-items: center;
    padding: .5rem .5rem .5rem 0;
    gap: 0;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex: 1;
    padding: .6rem 1.2rem;
    min-width: 0;
  }

  .search-icon {
    color: var(--amber);
    font-size: .9rem;
    flex-shrink: 0;
  }

  .search-input {
    border: none;
    background: transparent;
    font-size: .88rem;
    color: var(--bark);
    width: 100%;
    outline: none;
    font-family: inherit;
  }

  .search-input::placeholder {
    color: var(--mist);
  }

  .search-divider {
    width: 1px;
    height: 28px;
    background: var(--linen);
    flex-shrink: 0;
  }

  .btn-explore {
    background: var(--teal);
    color: white;
    border: none;
    border-radius: var(--radius);
    padding: .75rem 1.5rem;
    font-size: .88rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all .2s;
    flex-shrink: 0;
    margin-left: .5rem;
  }

  .btn-explore:hover {
    background: #0f3d48;
    transform: translateY(-1px);
  }

  /* ── PACKAGES SECTION ── */
  .packages-section {
    max-width: 1100px;
    margin: 4rem auto 0;
    padding: 0 2rem 3rem;
  }

  .packages-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr !important;
    gap: 1.25rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.75rem;
  }

  .section-title {
    font-family: 'Pogonia', serif;
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--bark);
    margin-bottom: .25rem;
  }

  .section-sub {
    font-size: .88rem;
    color: var(--mist);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--teal);
    font-size: .88rem;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid var(--teal);
    border-radius: 999px;
    padding: .4rem 1rem;
    transition: all .2s;
    white-space: nowrap;
  }

  .view-all-link:hover {
    background: var(--teal);
    color: white;
  }

  /* ── PACKAGE CARDS ── */
  .pkg-card {
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .pkg-card:hover {
    transform: none;
    box-shadow: none;
    border-color: transparent;
  }

  .pkg-img-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: var(--linen);
    margin-bottom: 10px;
  }

  .pkg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
    cursor: pointer;
  }

  .pkg-card:hover .pkg-img {
    transform: scale(1.04);
  }

  .pkg-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: var(--mist);
  }

  .pkg-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: white;
    color: var(--bark);
    font-size: .75rem;
    font-weight: 600;
    padding: .25rem .75rem;
    border-radius: 999px;
    box-shadow: 0 1px 4px rgba(0,0,0,.15);
    z-index: 2;
  }

  .pkg-body {
    padding: 4px 0 0;
  }

  .pkg-destination {
    font-size: .75rem;
    color: var(--teal);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .07em;
    margin-bottom: .25rem;
    display: flex;
    align-items: center;
    gap: .3rem;
  }

  .pkg-title {
    font-family: 'Pogonia', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--bark);
    margin-bottom: .4rem;
    line-height: 1.35;
  }

  .pkg-desc {
    font-size: .8rem;
    color: var(--mist);
    line-height: 1.6;
    margin-bottom: .75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pkg-info-row {
    display: flex;
    gap: .75rem;
    font-size: .78rem;
    color: var(--mist);
  }

  .pkg-info-row span {
    display: flex;
    align-items: center;
    gap: .25rem;
  }

  .pkg-info-row i {
    color: var(--teal);
  }

  /* ── WHY US ── */
  .why-section {
    background: #2a2728;
    padding: 4.5rem 2rem;
    margin-top: 2rem;
  }

  .why-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .why-header {
    margin-bottom: 2.5rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .why-item {
    text-align: center;
  }

  .why-icon {
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, .08);
    border: 1.5px solid rgba(239, 130, 51, .35);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    font-size: 1.5rem;
    color: var(--amber);
    transition: all .25s;
  }

  .why-item:hover .why-icon {
    background: rgba(239, 130, 51, .15);
    border-color: var(--amber);
    transform: scale(1.08);
  }

  .why-item h3 {
    font-family: 'Pogonia', serif;
    font-size: 1.1rem;
    color: #f5efe6;
    margin-bottom: .4rem;
    font-weight: 600;
  }

  .why-item p {
    font-size: .82rem;
    color: #8fa8a3;
    line-height: 1.7;
  }


  /* ── LIGHTBOX ── */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .85);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox img {
    max-width: 90%;
    max-height: 90vh;
    border-radius: var(--radius-lg);
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    color: white;
    font-size: 2rem;
    cursor: pointer;
    background: rgba(255, 255, 255, .15);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .18s;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, .3);
  }

  /* ── EMPTY STATE ── */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--mist);
  }

  .empty-state i {
    font-size: 3rem;
    opacity: .3;
    margin-bottom: 1rem;
    display: block;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pkg-card {
    animation: fadeUp .4s ease both;
  }

  .pkg-card:nth-child(1) {
    animation-delay: .05s;
  }

  .pkg-card:nth-child(2) {
    animation-delay: .12s;
  }

  .pkg-card:nth-child(3) {
    animation-delay: .19s;
  }

  .pkg-card:nth-child(4) {
    animation-delay: .26s;
  }

  .pkg-card:nth-child(5) {
    animation-delay: .33s;
  }

  .pkg-card:nth-child(6) {
    animation-delay: .4s;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-bottom: 1.5rem;
    }

    .hero-inner {
      padding-bottom: 1.5rem;
    }

    .search-section {
      position: relative;
      bottom: auto;
      left: auto;
      transform: none;
      width: calc(100% - 2rem);
      margin: -1.5rem auto 0;
    }

    .search-card {
      flex-direction: column;
      padding: 1rem;
      gap: 0;
    }

    .search-field {
      padding: .65rem .25rem;
      border-bottom: 1px solid var(--linen);
      flex: none;
    }

    .search-divider {
      display: none;
    }

    .btn-explore {
      width: 100%;
      border-radius: var(--radius);
      padding: .85rem;
      margin-top: .5rem;
      margin-left: 0;
    }

    .packages-grid {
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .why-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

</style>
{% endblock %}

{% block content %}

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <h1>Your Travels made<br><em>Worth it</em></h1>
    <p class="hero-sub">Handcrafted tour packages to the world's most breathtaking destinations. Let us do the planning
      — you do the living.</p>
    <div class="hero-actions">
      <a href="{{ url_for('packages.list_packages') }}" class="btn-hero-primary">
        <i class="fas fa-map-marked-alt"></i> Explore Packages
      </a>
      <a href="{{ url_for('main.contact') }}" class="btn-hero-ghost">
        <i class="fas fa-phone"></i> Talk to an Expert
      </a>
    </div>
  </div>

  <!-- SEARCH BAR -->
  <div class="search-section">
    <div class="search-heading">Where would you like to go?</div>
    <form class="search-card" action="{{ url_for('packages.list_packages') }}" method="GET">
      <div class="search-field">
        <i class="fas fa-map-pin search-icon"></i>
        <input class="search-input" type="text" name="destination" placeholder="Destination"
          value="{{ request.args.get('destination','') }}" />
      </div>
      <div class="search-divider"></div>
      <div class="search-field">
        <i class="fas fa-calendar search-icon"></i>
        <input class="search-input" type="text" name="departure_date" placeholder="Departure Date"
          value="{{ request.args.get('departure_date','') }}" onfocus="this.type='date'"
          onblur="if(!this.value)this.type='text'" />
      </div>
      <div class="search-divider"></div>
      <div class="search-field">
        <i class="fas fa-clock search-icon"></i>
        <input class="search-input" type="number" name="duration" placeholder="Duration (days)"
          value="{{ request.args.get('duration','') }}" style="width:130px" />
      </div>
      <div class="search-divider"></div>
      <div class="search-field">
        <i class="fas fa-users search-icon"></i>
        <input class="search-input" type="number" name="guests" placeholder="Guests"
          value="{{ request.args.get('guests','') }}" style="width:90px" />
      </div>
      <button type="submit" class="btn-explore">Explore Now</button>
    </form>
  </div>
</section>

<!-- FEATURED PACKAGES -->
<section class="packages-section">
  <div class="section-header">
    <div>
      <div class="section-title">Featured Packages</div>
      <div class="section-sub">Curated experiences for every kind of traveler</div>
    </div>
    <a href="{{ url_for('packages.list_packages') }}" class="view-all-link">
      View All <i class="fas fa-arrow-right"></i>
    </a>
  </div>

  {% if packages %}
  <div class="packages-grid">
    {% for pkg in packages %}
    <div class="pkg-card" onclick="window.location='{{ url_for('packages.package_detail', package_id=pkg.id) }}'">
      <div class="pkg-img-wrap">
        {% if pkg.is_featured %}<div class="pkg-badge">Featured</div>{% endif %}
        {% if pkg.image and pkg.image != 'default_tour.jpg' %}
        <img class="pkg-img" src="{{ (pkg.image | cloudinary_card) if pkg.image.startswith('http') else '/uploads/' + pkg.image }}"
          alt="{{ pkg.title }}" loading="lazy" />
        {% else %}
        <div class="pkg-img-placeholder"><i class="fas fa-mountain"></i></div>
        {% endif %}
      </div>
      <div class="pkg-body">
        <div class="pkg-destination">
          <i class="fas fa-location-dot"></i>
          {{ pkg.destination }}
          {% if pkg.country %} · {{ pkg.country.flag_emoji or '' }} {{ pkg.country.name }}{% endif %}
        </div>
        <div class="pkg-title">{{ pkg.title }}</div>
        <div class="pkg-desc">{{ pkg.description }}</div>
        <div class="pkg-info-row">
          <span><i class="fas fa-clock"></i> {{ pkg.duration_days }}d</span>
          <span><i class="fas fa-users"></i> {{ pkg.available_slots }} slots left</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty-state">
    <i class="fas fa-suitcase-rolling"></i>
    <p>No packages available yet. Check back soon!</p>
  </div>
  {% endif %}
</section>


<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <span class="lightbox-close" onclick="closeLightbox()">&times;</span>
  <img id="lightbox-img" src="" alt="" />
</div>

<script nonce="{{ csp_nonce() }}">
  function openLightbox(src) {
    document.getElementById('lightbox-img').src = src;
    document.getElementById('lightbox').classList.add('active');
  }

  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('active');
  }

  const destInput = document.querySelector('input[name="destination"]');
  const dropdown = document.createElement('div');
  dropdown.style.cssText =
    'position:absolute;top:100%;left:0;right:0;background:white;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,.15);z-index:99;overflow:hidden;display:none;margin-top:.5rem;';
  document.querySelector('.search-section').style.position = 'relative';
  document.querySelector('.search-section').appendChild(dropdown);

  destInput.addEventListener('input', function () {
    const q = this.value.trim();
    if (q.length < 2) {
      dropdown.style.display = 'none';
      return;
    }
    fetch(`/packages/autocomplete?q=${encodeURIComponent(q)}`)
      .then(r => r.json())
      .then(results => {
        if (!results.length) {
          dropdown.style.display = 'none';
          return;
        }
        dropdown.innerHTML = results.map(r => `
          <div style="padding:.75rem 1.5rem;cursor:pointer;font-size:.9rem;color:var(--bark);transition:background .15s;"
              onmouseover="this.style.background='#f7f2ec'"
              onmouseout="this.style.background='white'"
              onclick="document.querySelector('input[name=destination]').value='${r.name}';this.parentElement.style.display='none';">
            <i class="fas fa-map-pin" style="color:var(--teal-d);margin-right:.5rem;"></i> ${r.name}
          </div>`).join('');
        dropdown.style.display = 'block';
      });
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('.search-section')) dropdown.style.display = 'none';
  });

</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "name": "Travel Worthy PH",
    "url": "{{ config['SITE_URL'] }}",
    "logo": "{{ config['SITE_URL'] }}/static/images/LOGO.jpg",
    "description": "Crafting unforgettable journeys since 2019. Handcrafted tour packages to the world's most breathtaking destinations.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "PH"
    },
    "sameAs": [
      "https://www.facebook.com/travelworthyph",
      "https://www.instagram.com/travelworthyph/",
      "https://tiktok.com/@travelworthyph"
    ]
  }

</script>
{% endblock %}
