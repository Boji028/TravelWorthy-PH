@@ -0,0 +1,113 @@
+{% extends "base.html" %}
+{% block title %}Cookie Policy — Travel Worthy PH{% endblock %}
+
+{% block extra_styles %}
+<style>
+  .legal-hero {
+    background: linear-gradient(135deg, var(--teal-d), var(--teal));
+    color: var(--white);
+    padding: 3rem 2rem 3.5rem;
+    text-align: center;
+  }
+
+  .legal-hero h1 {
+    font-family: 'Pogonia', serif;
+    font-size: 2.6rem;
+    font-weight: 300;
+    margin-bottom: .4rem;
+  }
+
+  .legal-hero p { font-size: .9rem; opacity: .85; }
+
+  .legal-body {
+    max-width: 780px;
+    margin: 0 auto;
+    padding: 3rem 1.5rem 4rem;
+    color: var(--bark);
+    line-height: 1.75;
+  }
+
+  .legal-body h2 { font-size: 1.25rem; color: var(--ink); margin: 2.25rem 0 .75rem; }
+  .legal-body h2:first-of-type { margin-top: 0; }
+  .legal-body p { margin-bottom: 1rem; }
+  .legal-body ul { margin: 0 0 1rem 1.25rem; }
+  .legal-body li { margin-bottom: .4rem; }
+  .legal-body a { color: var(--teal); }
+
+  .legal-note {
+    background: var(--sand);
+    border-radius: var(--radius);
+    padding: 1rem 1.25rem;
+    font-size: .9rem;
+    margin-bottom: 2rem;
+  }
+
+  @media (max-width: 768px) {
+    .legal-hero { padding: 2.25rem 1rem 2.5rem; }
+    .legal-hero h1 { font-size: 1.9rem; }
+    .legal-body { padding: 2rem 1.25rem 3rem; }
+  }
+</style>
+{% endblock %}
+
+{% block content %}
+<div class="legal-hero">
+  <h1>Cookie Policy</h1>
+  <p>What this website stores in your browser, and why</p>
+</div>
+
+<div class="legal-body">
+  <div class="legal-note">
+    This website uses very few cookies. We do not use advertising cookies, and
+    we do not track you across other websites.
+  </div>
+
+  <h2>What cookies we use</h2>
+  <p>
+    We set one cookie, a session cookie, which keeps you signed in while you
+    use the site and protects forms against cross-site request forgery. It is
+    strictly necessary for the website to work and expires after 24 hours or
+    when you sign out.
+  </p>
+  <p>
+    This cookie is marked HttpOnly, meaning scripts cannot read it, and
+    SameSite Lax, meaning it is not sent from other websites.
+  </p>
+
+  <h2>What we do not use</h2>
+  <ul>
+    <li>No advertising or retargeting cookies</li>
+    <li>No analytics or visitor tracking cookies</li>
+    <li>No social media tracking pixels</li>
+  </ul>
+
+  <h2>Third party services</h2>
+  <p>
+    Some files on this site are served by other companies. These do not set
+    cookies for us, but they do receive your IP address as part of delivering
+    the file, which is how the web works for any externally hosted resource.
+  </p>
+  <ul>
+    <li>Cloudinary, which stores and delivers our package images</li>
+    <li>Google Fonts and Cloudflare, which deliver fonts and icons</li>
+  </ul>
+  <p>
+    Links to our Facebook, Instagram, and TikTok pages are ordinary links. They
+    load nothing until you click them, and no content from those platforms is
+    embedded here.
+  </p>
+
+  <h2>Managing cookies</h2>
+  <p>
+    You can clear or block cookies in your browser settings. Blocking the
+    session cookie will prevent you from signing in or submitting forms, since
+    the site relies on it to keep you logged in and to validate submissions.
+  </p>
+
+  <h2>Related policies</h2>
+  <p>
+    See our <a href="{{ url_for('main.privacy_policy') }}">Privacy Policy</a>
+    for how we handle the personal information you send us.
+  </p>
+</div>
+{% endblock %}
