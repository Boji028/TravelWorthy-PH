+{% extends "base.html" %}
+{% block title %}Privacy Policy — Travel Worthy PH{% endblock %}
+
+{% block extra_styles %}
+<style>
+  .legal-hero {
+    background: linear-gradient(135deg, var(--teal-d), var(--teal));
+    color: var(--white);
