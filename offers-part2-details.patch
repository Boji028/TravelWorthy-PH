+
+    // Picking an available date fills the quote form and takes you there.
+    document.querySelectorAll('.od-date').forEach(function (btn) {
+      btn.addEventListener('click', function () {
+        document.querySelectorAll('.od-date').forEach(function (b) { b.classList.remove('picked'); });
+        btn.classList.add('picked');
+        fromEl.value = btn.dataset.from;
+        toEl.value = btn.dataset.to;
+        fromEl.dispatchEvent(new Event('change'));
+        toEl.dispatchEvent(new Event('change'));
+        document.getElementById('od-inquire').scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+    });
+
+    // Full-size viewer for gallery photos and the flier.
+    var viewer = document.getElementById('od-viewer');
+    if (!viewer) return;
+    var sets = {
+      gallery: {{ gallery | map('cloudinary_enhance') | list | tojson }},
+      flier: {{ ([offer.flier_image | cloudinary_enhance] if offer.flier_image else []) | tojson }}
+    };
+    var img = document.getElementById('od-viewer-img');
+    var count = document.getElementById('od-viewer-count');
+    var download = document.getElementById('od-viewer-download');
+    var title = {{ offer.title | tojson }};
+    var current = [], index = 0, lastFocus = null;
+
+    function show() {
+      var src = current[index];
+      src = src.indexOf('http') === 0 ? src : '/uploads/' + src;
+      img.src = src;
+      img.alt = title + ' photo ' + (index + 1) + ' of ' + current.length;
+      download.href = src;
+      count.textContent = current.length > 1 ? (index + 1) + ' / ' + current.length : '';
+      document.getElementById('od-viewer-prev').hidden = current.length < 2;
+      document.getElementById('od-viewer-next').hidden = current.length < 2;
+    }
+    function open(set, i) {
+      current = sets[set];
+      index = i;
+      lastFocus = document.activeElement;
+      show();
+      viewer.classList.add('open');
+      document.body.style.overflow = 'hidden';
+      document.getElementById('od-viewer-close').focus();
+    }
+    function close() {
+      viewer.classList.remove('open');
+      document.body.style.overflow = '';
+      if (lastFocus) lastFocus.focus();
+    }
+    function step(d) {
+      index = (index + d + current.length) % current.length;
+      show();
+    }
+    document.querySelectorAll('[data-viewer]').forEach(function (btn) {
+      btn.addEventListener('click', function () { open(btn.dataset.viewer, parseInt(btn.dataset.index, 10)); });
+    });
+    document.getElementById('od-viewer-close').addEventListener('click', close);
+    document.getElementById('od-viewer-prev').addEventListener('click', function () { step(-1); });
+    document.getElementById('od-viewer-next').addEventListener('click', function () { step(1); });
+    viewer.addEventListener('click', function (e) { if (e.target === viewer) close(); });
+    document.addEventListener('keydown', function (e) {
+      if (!viewer.classList.contains('open')) return;
+      if (e.key === 'Escape') close();
+      if (e.key === 'ArrowRight') step(1);
+      if (e.key === 'ArrowLeft') step(-1);
+    });
   });
 </script>
